{
  "name": "design-system-inspector",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "package": "npm run build && node scripts/package.mjs",
    "dev:harness": "vite --config vite.harness.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
